# The only .gitignore in this repository. Patterns without a leading "/" match at any depth, so
# they cover backend/ and frontend/ alike.

# Build output
target/
.apt_generated/
generated/

# Compiled and packaged files
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Next.js - dependencies, build output, generated types
node_modules/
.next/
next-env.d.ts
*.tsbuildinfo

# Playwright output, and the saved signed-in session (a live session cookie)
playwright-report/
test-results/
.auth/

# Logs and JVM crash dumps
*.log
hs_err_pid*

# IntelliJ
*.iml
.idea/

# Eclipse
.classpath
.factorypath
.metadata
.project
.settings
.tern-project

# Local developer overrides (credentials) - never commit
application-local.properties
.env
