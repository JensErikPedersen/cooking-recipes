# Copy to .env and fill in real values. .env is gitignored; this file is not.
#
#   PowerShell : copy .env.example .env
#   Bash       : cp .env.example .env
#
# Placeholders only in this file. Never commit a real password here - that is how the last one
# ended up on GitHub.
#
# ------------------------------------------------------------------------------------------------
# TWO THINGS THAT WILL COST YOU AN HOUR EACH
#
# 1. "#" IN A VALUE IS A COMMENT, AND COMPOSE TRUNCATES IT SILENTLY.
#
#       DB_PASSWORD=secret#2026      ->  the container receives "secret"
#       DB_PASSWORD='secret#2026'    ->  the container receives "secret#2026"
#
#    Nothing warns you. The stack still comes up, because MySQL is created with the truncated
#    password and the backend connects with the same truncated one. Single-quote any value
#    containing "#", or avoid the character.
#
# 2. SPRING BOOT DOES NOT READ THIS FILE. Docker Compose does, and passes values to the backend
#    container through its "environment:" block. But a host-side "./mvnw spring-boot:run" ignores
#    .env entirely - export the variables yourself, as backend/README.md describes. Symptom if you
#    forget: "Access denied for user 'recipesuser'", with a .env that looks perfectly correct.
# ------------------------------------------------------------------------------------------------

# --- MySQL ---------------------------------------------------------------------------------------
# Used by the mysql container only. Also by the container healthcheck, which pings as root.
MYSQL_ROOT_PASSWORD=change-me-root

DB_NAME=recipes

# Where the backend reaches MySQL from inside the compose network - the service name, not localhost.
DB_HOST=mysql
DB_PORT=3306

# Where MySQL is published on your machine, for a GUI client or a host-side mvnw run. Deliberately
# not 3306: a local MySQL is usually already listening there, and the clash fails the whole stack.
DB_HOST_PORT=3307

# --- Application database account -----------------------------------------------------------------
# One account for the MVP. Liquibase and the running application both use it, so it needs DDL
# rights - which is what the MySQL entrypoint grants on the schema it creates.
#
# Splitting this into a DDL account for Liquibase and a DML-only account for the runtime is the
# correct production shape, and is recorded in backend/docs/future_enhancements.md rather than
# built here.
DB_USERNAME=recipesuser
DB_PASSWORD=change-me-user

# --- First-run administrator ------------------------------------------------------------------------
# Created by AdminBootstrap on startup, and ONLY while the app_user table is empty. Changing this
# afterwards does nothing to an account that already exists - change the password through the
# application instead.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin-account

# --- Backend -----------------------------------------------------------------------------------
APPLICATION_PORT=8080

# --- Frontend ----------------------------------------------------------------------------------
# The browser only talks to the Next.js origin; its /api rewrite reaches the backend at
# http://backend:APPLICATION_PORT, which docker-compose.yml derives, so there is no URL to set here.
FRONTEND_PORT=3000
