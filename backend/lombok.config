# Root of the Lombok config chain for this project.
config.stopBubbling = true

# @Jacksonized generates @JsonDeserialize/@JsonPOJOBuilder, and those annotations live in a
# different package for Jackson 2 (com.fasterxml.jackson.databind.annotation) than for Jackson 3
# (tools.jackson.databind.annotation). Lombok will not guess: without this key it silently emits
# the Jackson 2 pair and warns on every annotated DTO.
#
# Spring Boot 4 defaults to Jackson 3. Getting this wrong means every write DTO fails to
# deserialise while @WebMvcTest still passes, because slice tests build their own mapper.
# JsonContractIT is the guard; javap on a built DTO is the proof - see CLAUDE.md.
lombok.jacksonized.jacksonVersion = 3
